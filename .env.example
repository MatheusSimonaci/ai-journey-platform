# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ai_journey?sslmode=require"

# Anthropic (optional: if omitted, onboarding falls back to a deterministic path builder)
ANTHROPIC_API_KEY="sk-ant-..."

# Auth.js
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID="..."
AUTH_GOOGLE_SECRET="..."
AUTH_RESEND_KEY="re_..."
AUTH_EMAIL_FROM="noreply@yourdomain.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Token Spend Controls
DEFAULT_MONTHLY_TOKEN_LIMIT="1000000"
DEFAULT_DAILY_TOKEN_LIMIT="100000"
